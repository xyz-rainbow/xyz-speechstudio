{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech Studio",
  "version": "0.1.0",
  "identifier": "com.xyz.speechstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Speech Studio",
        "width": 880,
        "height": 580,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
