{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speechstudio.voice_pack.v1",
  "title": "Speech Studio voice pack manifest",
  "type": "object",
  "required": ["schema", "pack_id", "name", "version", "engine", "required_model_id", "required_quant_id", "voices"],
  "properties": {
    "schema": { "const": "speechstudio.voice_pack.v1" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "engine": { "type": "string" },
    "required_model_id": { "type": "string" },
    "required_quant_id": { "type": "string" },
    "voice_count": { "type": "integer", "minimum": 0 },
    "locales": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "object" },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "locale",
          "audio_relpath",
          "text_relpath",
          "audio_sha256",
          "text_sha256",
          "format"
        ],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,16}){0,3}$" },
          "language": { "type": "string" },
          "gender": { "type": "string" },
          "audio_relpath": { "type": "string" },
          "text_relpath": { "type": "string" },
          "audio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "duration_s": { "type": ["number", "null"] },
          "format": { "type": "string" },
          "size_bytes": { "type": "integer" },
          "provenance": { "type": "object" }
        }
      }
    },
    "excluded": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
