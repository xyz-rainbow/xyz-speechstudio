#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
if [[ -x "$ROOT/runtime/python/bin/python3" ]]; then
  PY="$ROOT/runtime/python/bin/python3"
elif [[ -x "$ROOT/runtime/envs/core/bin/python" ]]; then
  PY="$ROOT/runtime/envs/core/bin/python"
elif [[ -x "$ROOT/.venvs/core/bin/python" ]]; then
  PY="$ROOT/.venvs/core/bin/python"
else
  echo "Speech Studio Python environment not found under runtime/envs/core (or legacy .venvs/core)" >&2
  exit 1
fi
exec "$PY" -m backend.cli.main "$@"
